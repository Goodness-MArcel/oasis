<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body class="admin-layout bg-light">
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <div class="admin-sidebar-header d-flex align-items-center justify-content-between mb-4">
          <a href="/admin/dashboard" class="d-inline-flex align-items-center text-decoration-none admin-sidebar-brand">
            <img src="/images/logo.png" alt="Integrated Oasis Logo" height="28" class="me-2" />
            <span class="fw-semibold text-dark small admin-sidebar-brand-text">Admin</span>
          </a>
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm admin-sidebar-toggle"
            id="adminSidebarToggle"
            aria-label="Toggle sidebar width"
          >
            <i class="fa-solid fa-angles-left"></i>
          </button>
        </div>

        <nav class="admin-sidebar-nav nav flex-column mb-auto small">
          <a href="/admin/dashboard" class="nav-link d-flex align-items-center gap-2 mb-3 <%= currentPath.startsWith('/admin/dashboard') || currentPath === '/admin' ? 'active' : 'text-muted' %>">
            <i class="fa-solid fa-gauge-high"></i>
            <span>Dashboard</span>
          </a>
          <a href="/admin/courses" class="nav-link d-flex align-items-center gap-2 mb-3 <%= currentPath.startsWith('/admin/courses') ? 'active' : 'text-muted' %>">
            <i class="fa-solid fa-book-open"></i>
            <span>Manage Courses</span>
          </a>
          <a href="/admin/users" class="nav-link d-flex align-items-center gap-2 mb-3 <%= currentPath.startsWith('/admin/users') ? 'active' : 'text-muted' %>">
            <i class="fa-solid fa-users"></i>
            <span>Users</span>
          </a>

          <a href="/admin/analytics" class="nav-link d-flex align-items-center gap-2 mb-3 <%= currentPath.startsWith('/admin/analytics') ? 'active' : 'text-muted' %>">
            <i class="fa-solid fa-chart-line"></i>
            <span>Analytics</span>
          </a>
          

            <a href="/admin/revenue" class="nav-link d-flex align-items-center gap-2 mb-3 <%= currentPath.startsWith('/admin/revenue') ? 'active' : 'text-muted' %>">
                <i class="fa-solid fa-naira-sign"></i>
                <span>Revenue</span>
            </a>

          <a href="/admin/settings" class="nav-link d-flex align-items-center gap-2 mb-3 <%= currentPath.startsWith('/admin/settings') ? 'active' : 'text-muted' %>">
            <i class="fa-solid fa-gear"></i>
            <span>Settings</span>
          </a>
        </nav>

        <div class="admin-sidebar-footer mt-4 small">
          <span class="badge bg-success-subtle text-success d-inline-flex align-items-center gap-1 mb-2 admin-sidebar-badge">
            <i class="fa-solid fa-shield-halved"></i> Admin
          </span>
          <!-- Placeholder logout button (no auth wired yet) -->
          <button type="button" class="btn btn-outline-secondary btn-sm w-100" data-bs-toggle="modal" data-bs-target="#logoutModal">
            <i class="fa-solid fa-right-from-bracket me-1"></i>
            <span class="admin-sidebar-logout-text">Logout</span>
          </button>

          <!-- Logout Confirmation Modal moved to end of body for proper stacking -->
        </div>
      </aside>

      <main class="admin-main container-fluid py-4 px-3 px-md-4">
        <%- body %>
      </main>
    </div>

    <!-- Logout Confirmation Modal (moved for z-index fix) -->
    <div class="modal fade modal-admin-logout" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header d-flex align-items-center gap-2">
            <h5 class="modal-title mb-0" id="logoutModalLabel">Confirm Logout</h5>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-center">
            <i class="fa-solid fa-right-from-bracket mb-3" style="color: var(--primary-green); font-size: 2.2rem;"></i>
            <div>Are you sure you want to log out?</div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <form action="/admin/logout" method="post" class="d-inline m-0 p-0">
              <button type="submit" class="btn btn-danger">Logout</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- User Details Modal (moved here for z-index fix) -->
    <div class="modal fade modal-admin-logout" id="userDetailsModal" tabindex="-1" aria-labelledby="userDetailsModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
          <div class="modal-header align-items-center" style="border-bottom: 1px solid #e5e7eb; background: rgba(22, 163, 74, 0.08);">
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-user-circle fa-2x" style="color: #166534;"></i>
              <div>
                <h5 class="modal-title mb-0" id="userDetailsModalLabel" style="color: #166534; font-weight: 600;">User Details</h5>
                <div class="small text-muted" id="userDetailsUsername"></div>
              </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
            <div class="row">
              <div class="col-md-6">
                <h6 class="fw-bold mb-3" style="color: #166534;"><i class="fa-solid fa-user me-2"></i>Personal Information</h6>
                <ul class="list-group list-group-flush mb-4" id="personalInfoList">
                  <!-- Populated by JS -->
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="fw-bold mb-3" style="color: #166534;"><i class="fa-solid fa-calendar me-2"></i>Account Details</h6>
                <ul class="list-group list-group-flush mb-4" id="accountInfoList">
                  <!-- Populated by JS -->
                </ul>
                <h6 class="fw-bold mb-3" style="color: #166534;"><i class="fa-solid fa-book me-2"></i>Enrolled Courses</h6>
                <ul class="list-group list-group-flush" id="coursesList">
                  <!-- Populated by JS -->
                </ul>
              </div>
            </div>

            <hr class="my-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="fw-bold mb-0" style="color: #166534;"><i class="fa-solid fa-credit-card me-2"></i>Payment History</h6>
              <div id="paymentSummary" class="badge bg-info">Loading...</div>
            </div>
            <div id="paymentsList">
              <div class="text-muted small">No payments found</div>
            </div>
          </div>
          <div class="modal-footer d-flex justify-content-between" style="border-top: 1px solid #e5e7eb;">
            <div>
              <button type="button" class="btn btn-danger me-2" id="deleteUserBtn"><i class="fa-solid fa-trash me-1"></i> Delete</button>
              <button type="button" class="btn btn-warning" id="suspendUserBtn"><i class="fa-solid fa-user-slash me-1"></i> Suspend</button>
            </div>
            <button type="button" class="btn" style="background: var(--accent-blue); border-color: var(--accent-blue); color: #fff;" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <style>
      /* Force modal and backdrop above all overlays */
      .modal-admin-logout {
        z-index: 9999 !important;
      }
      .modal-backdrop.show {
        z-index: 9998 !important;
      }
      .modal-admin-logout .modal-content {
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 8px 32px rgba(46, 139, 87, 0.10);
      }
      .modal-admin-logout .modal-header {
        background: rgba(22, 163, 74, 0.08);
        border-bottom: 1px solid #e5e7eb;
      }
      .modal-admin-logout .modal-title {
        color: #166534;
        font-weight: 600;
      }
      .modal-admin-logout .modal-footer {
        border-top: 1px solid #e5e7eb;
      }
      .modal-admin-logout .btn-danger {
        background: var(--primary-green);
        border-color: var(--primary-green);
        color: #fff;
      }
      .modal-admin-logout .btn-danger:hover {
        background: var(--secondary-green);
        border-color: var(--secondary-green);
      }
      .modal-admin-logout .btn-secondary {
        background: var(--accent-blue);
        border-color: var(--accent-blue);
        color: #fff;
      }
      .modal-admin-logout .btn-secondary:hover {
        background: #357ab7;
        border-color: #357ab7;
      }
      .modal-admin-logout .list-group-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        border: none;
        border-bottom: 1px solid #f1f1f1;
        font-size: 1rem;
      }
      .modal-admin-logout .list-group-item:last-child {
        border-bottom: none;
      }
      .modal-admin-logout .fw-bold {
        color: #166534;
      }
    </style>

    <script>
      // Fix for Bootstrap modal stacking and ensure visibility
      document.addEventListener('shown.bs.modal', function (event) {
        if (event.target.id === 'userDetailsModal') {
          document.body.classList.add('modal-open');
          event.target.style.zIndex = 9999;
          var backdrops = document.getElementsByClassName('modal-backdrop');
          for (var i = 0; i < backdrops.length; i++) {
            backdrops[i].style.zIndex = 9998;
          }
        }
      });

      // Modal logic for user details
      window.addEventListener('load', function() {
        // Toast notification function
        function showToast(message, type = 'success') {
          const toastEl = document.getElementById('emailToast');
          const toastIcon = document.getElementById('toastIcon');
          const toastMessage = document.getElementById('toastMessage');

          if (!toastEl || !toastIcon || !toastMessage) return;

          // Set message
          toastMessage.textContent = message;

          // Set icon and styling based on type
          toastEl.className = 'toast align-items-center text-white border-0';
          switch(type) {
            case 'success':
              toastEl.classList.add('toast-success');
              toastIcon.className = 'fa-solid fa-check-circle me-2';
              break;
            case 'error':
              toastEl.classList.add('toast-error');
              toastIcon.className = 'fa-solid fa-exclamation-triangle me-2';
              break;
            case 'info':
              toastEl.classList.add('toast-info');
              toastIcon.className = 'fa-solid fa-info-circle me-2';
              break;
          }

          // Show toast
          const toast = new bootstrap.Toast(toastEl, {
            delay: 5000 // Auto hide after 5 seconds
          });
          toast.show();
        }

        const userDetailsModal = document.getElementById('userDetailsModal');
        const personalInfoList = document.getElementById('personalInfoList');
        const accountInfoList = document.getElementById('accountInfoList');
        const coursesList = document.getElementById('coursesList');
        const paymentsList = document.getElementById('paymentsList');
        const paymentSummaryEl = document.getElementById('paymentSummary');
        let currentUser = null;

        document.querySelectorAll('.view-user-btn').forEach(btn => {
          btn.addEventListener('click', function() {
            const user = JSON.parse(this.getAttribute('data-user'));
            currentUser = user;
            personalInfoList.innerHTML = '';
            accountInfoList.innerHTML = '';
            coursesList.innerHTML = '';
            paymentsList.innerHTML = '';
            // Show username in header
            document.getElementById('userDetailsUsername').textContent = user.username ? `@${user.username}` : '';

            // Personal Info
            const personalFields = ['id', 'username', 'email', 'gender', 'role'];
            personalFields.forEach(key => {
              if (user[key] !== undefined && key !== 'password') {
                personalInfoList.innerHTML += `<li class="list-group-item d-flex justify-content-between"><span>${key.charAt(0).toUpperCase() + key.slice(1)}</span><span class="fw-semibold">${user[key] ?? ''}</span></li>`;
              }
            });

            // Account Info
            const accountFields = ['createdAt', 'updatedAt'];
            accountFields.forEach(key => {
              if (user[key] !== undefined) {
                let value = user[key];
                if (key === 'createdAt' || key === 'updatedAt') {
                  value = value ? new Date(value).toLocaleString() : '';
                }
                accountInfoList.innerHTML += `<li class="list-group-item d-flex justify-content-between"><span>${key === 'createdAt' ? 'Joined' : 'Last Updated'}</span><span class="fw-semibold">${value}</span></li>`;
              }
            });

            // Courses
            if (user.enrollments && user.enrollments.length > 0) {
              user.enrollments.forEach(enrollment => {
                if (enrollment.course) {
                  coursesList.innerHTML += `<li class="list-group-item d-flex justify-content-between"><span>${enrollment.course.title}</span><span class="badge bg-success">${enrollment.course.category}</span></li>`;
                }
              });
            } else {
              coursesList.innerHTML = '<li class="list-group-item text-muted"><i class="fa-solid fa-info-circle me-2"></i>No courses yet</li>';
            }

            // Calculate payment summary
            let paymentSummary = '';

            if (user.payments && user.payments.length > 0) {
              const totalPayments = user.payments.length;
              const paidPayments = user.payments.filter(p => (p.installment_status || p.status) === 'paid' || (p.installment_status || p.status) === 'completed').length;
              const pendingPayments = user.payments.filter(p => (p.installment_status || p.status) === 'pending').length;
              const overduePayments = user.payments.filter(p => (p.installment_status || p.status) === 'overdue').length;
              const failedPayments = user.payments.filter(p => (p.installment_status || p.status) === 'failed').length;

              // Check if this is an installment plan
              const hasInstallments = user.payments.some(p => p.total_installments > 1);
              const totalInstallments = hasInstallments ? Math.max(...user.payments.map(p => p.total_installments || 1)) : 1;

              if (hasInstallments) {
                if (paidPayments === totalInstallments) {
                  paymentSummary = '<span class="badge bg-success">All Paid</span>';
                } else if (overduePayments > 0) {
                  paymentSummary = `<span class="badge bg-danger">${paidPayments}/${totalInstallments} Paid (${overduePayments} Overdue)</span>`;
                } else if (pendingPayments > 0) {
                  paymentSummary = `<span class="badge bg-warning">${paidPayments}/${totalInstallments} Paid</span>`;
                } else {
                  paymentSummary = `<span class="badge bg-secondary">${paidPayments}/${totalInstallments} Paid</span>`;
                }
              } else {
                // Single payments
                if (paidPayments === totalPayments) {
                  paymentSummary = '<span class="badge bg-success">Paid</span>';
                } else if (overduePayments > 0) {
                  paymentSummary = '<span class="badge bg-danger">Overdue</span>';
                } else if (pendingPayments > 0) {
                  paymentSummary = '<span class="badge bg-warning">Pending</span>';
                } else if (failedPayments > 0) {
                  paymentSummary = '<span class="badge bg-danger">Failed</span>';
                } else {
                  paymentSummary = '<span class="badge bg-secondary">Unknown</span>';
                }
              }
            } else {
              paymentSummary = '<span class="badge bg-light text-dark">No Payments</span>';
            }

            paymentSummaryEl.innerHTML = paymentSummary;

            // Always show the payment section
            if (user.payments && user.payments.length > 0) {
              const paymentHtml = user.payments.map(payment => {
                const courseTitle = payment.course ? payment.course.title : 'Unknown Course';
                const coursePrice = payment.course ? payment.course.price : 0;
                const installmentInfo = payment.total_installments > 1 ?
                  ` (Installment ${payment.installment_number}/${payment.total_installments})` : '';

                let statusBadge = '';
                switch (payment.installment_status || payment.status) {
                  case 'paid':
                  case 'completed':
                    statusBadge = '<span class="badge bg-success">Paid</span>';
                    break;
                  case 'pending':
                    statusBadge = '<span class="badge bg-warning">Pending</span>';
                    break;
                  case 'overdue':
                    statusBadge = '<span class="badge bg-danger">Overdue</span>';
                    break;
                  case 'failed':
                    statusBadge = '<span class="badge bg-danger">Failed</span>';
                    break;
                  case 'cancelled':
                    statusBadge = '<span class="badge bg-secondary">Cancelled</span>';
                    break;
                  default:
                    statusBadge = '<span class="badge bg-secondary">Unknown</span>';
                }

                const paidDate = payment.paid_date ? new Date(payment.paid_date).toLocaleDateString() : 'N/A';
                const balanceInfo = payment.balance_remaining > 0 ?
                  `<div class="text-muted small">Balance Remaining: $${payment.balance_remaining}</div>` : '';

                // Show add payment button if there's remaining balance
                const addPaymentButton = payment.balance_remaining > 0 ?
                  `<button class="btn btn-success btn-sm add-payment-btn ms-2" 
                           data-payment-id="${payment.id}"
                           data-course-title="${courseTitle}"
                           data-balance-remaining="${payment.balance_remaining}">
                    <i class="fa-solid fa-plus"></i> Add Payment
                  </button>` : '';

                return `
                  <div class="mb-3 p-3 border rounded">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <div class="flex-grow-1">
                        <div class="fw-semibold">${courseTitle}${installmentInfo}</div>
                        <div class="text-muted small">Total Amount: $${payment.amount}</div>
                        <div class="text-muted small">Total Paid: $${payment.total_paid || 0}</div>
                        <div class="text-muted small">Paid Date: ${paidDate}</div>
                        ${balanceInfo}
                      </div>
                      <div class="d-flex flex-column gap-2" style="min-width: 200px;">
                        <div class="input-group input-group-sm">
                          <span class="input-group-text">$</span>
                          <input type="number" class="form-control form-control-sm amount-paid-input" 
                                 data-payment-id="${payment.id}" 
                                 placeholder="Amount Paid" 
                                 step="0.01" 
                                 min="0"
                                 value="${payment.installment_status === 'paid' || payment.status === 'completed' ? (payment.installment_amount || payment.amount) : ''}">
                        </div>
                        <div class="d-flex gap-1">
                          <select class="form-select form-select-sm payment-status-select" 
                                  data-payment-id="${payment.id}" 
                                  style="flex: 1;">
                            <option value="pending" ${payment.installment_status === 'pending' || payment.status === 'pending' ? 'selected' : ''}>Pending</option>
                            <option value="paid" ${payment.installment_status === 'paid' || payment.status === 'completed' ? 'selected' : ''}>Paid</option>
                            <option value="overdue" ${payment.installment_status === 'overdue' ? 'selected' : ''}>Overdue</option>
                            <option value="failed" ${payment.installment_status === 'failed' || payment.status === 'failed' ? 'selected' : ''}>Failed</option>
                            <option value="cancelled" ${payment.installment_status === 'cancelled' || payment.status === 'cancelled' ? 'selected' : ''}>Cancelled</option>
                          </select>
                          <button class="btn btn-outline-primary btn-sm update-payment-btn" 
                                  data-payment-id="${payment.id}"
                                  data-current-status="${payment.installment_status || payment.status}">
                            <i class="fa-solid fa-save"></i>
                          </button>
                          ${addPaymentButton}
                        </div>
                      </div>
                    </div>
                  </div>
                `;
              }).join('');
              paymentsList.innerHTML = paymentHtml;

              // Add event listeners for payment updates
              setTimeout(() => {
                addPaymentUpdateListeners(user);
              }, 100);
            } else {
              paymentsList.innerHTML = '<div class="text-muted small">No payments found</div>';
            }

            // Show the modal
            const modal = new bootstrap.Modal(userDetailsModal);
            modal.show();
          });
        });

        function addPaymentUpdateListeners(user) {
          const updateButtons = document.querySelectorAll('.update-payment-btn');
          const addPaymentButtons = document.querySelectorAll('.add-payment-btn');
          
          updateButtons.forEach(btn => {
            btn.addEventListener('click', async function() {
              const paymentId = this.getAttribute('data-payment-id');
              const currentStatus = this.getAttribute('data-current-status');
              const selectEl = document.querySelector(`.payment-status-select[data-payment-id="${paymentId}"]`);
              const amountInputEl = document.querySelector(`.amount-paid-input[data-payment-id="${paymentId}"]`);
              const newStatus = selectEl ? selectEl.value : currentStatus;
              const amountPaid = amountInputEl ? parseFloat(amountInputEl.value || 0) : 0;

              // Find the payment to get expected amount
              const payment = user.payments.find(p => p.id == paymentId);
              const expectedAmount = payment ? (payment.installment_amount || payment.amount) : 0;

              if (newStatus === currentStatus && amountPaid === 0) {
                showToast('No changes to save', 'info');
                return;
              }

              // Validate amount if status is paid
              if ((newStatus === 'paid' || newStatus === 'completed') && amountPaid <= 0) {
                showToast('Please enter the amount paid when marking as paid', 'error');
                return;
              }

              if (newStatus === 'paid' || newStatus === 'completed') {
                if (confirm(`Update payment status to "${newStatus}" with amount $${amountPaid.toFixed(2)}?`)) {
                  // Proceed with update
                } else {
                  return;
                }
              } else {
                if (confirm(`Update payment status to "${newStatus}"?`)) {
                  // Proceed with update
                } else {
                  return;
                }
              }

              try {
                const response = await fetch(`/admin/payments/${paymentId}/status`, {
                  method: 'PUT',
                  headers: {
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify({ 
                    status: newStatus,
                    amountPaid: amountPaid > 0 ? amountPaid : undefined
                  })
                });

                const result = await response.json();

                if (result.success) {
                  showToast('Payment updated successfully', 'success');
                  this.setAttribute('data-current-status', newStatus);
                  
                  // Update the cached user data with the new payment status and amount
                  if (user.payments) {
                    const paymentToUpdate = user.payments.find(p => p.id == paymentId);
                    if (paymentToUpdate) {
                      paymentToUpdate.installment_status = newStatus;
                      paymentToUpdate.status = newStatus === 'paid' ? 'completed' : newStatus;
                      if (newStatus === 'paid' || newStatus === 'completed') {
                        paymentToUpdate.paid_date = new Date().toISOString();
                        if (amountPaid > 0) {
                          paymentToUpdate.installment_amount = amountPaid;
                        }
                      }
                      // Update the data-user attribute with fresh data
                      const viewBtn = document.querySelector('.view-user-btn');
                      if (viewBtn) {
                        viewBtn.setAttribute('data-user', JSON.stringify(user));
                      }
                    }
                  }

                  // Update the payment summary badge
                  const totalPayments = user.payments.length;
                  const paidPayments = user.payments.filter(p => (p.installment_status || p.status) === 'paid' || (p.installment_status || p.status) === 'completed').length;
                  const pendingPayments = user.payments.filter(p => (p.installment_status || p.status) === 'pending').length;
                  const overduePayments = user.payments.filter(p => (p.installment_status || p.status) === 'overdue').length;

                  const hasInstallments = user.payments.some(p => p.total_installments > 1);
                  const totalInstallments = hasInstallments ? Math.max(...user.payments.map(p => p.total_installments || 1)) : 1;

                  let paymentSummary = '';
                  if (hasInstallments) {
                    if (paidPayments === totalInstallments) {
                      paymentSummary = '<span class="badge bg-success">All Paid</span>';
                    } else if (overduePayments > 0) {
                      paymentSummary = `<span class="badge bg-danger">${paidPayments}/${totalInstallments} Paid (${overduePayments} Overdue)</span>`;
                    } else if (pendingPayments > 0) {
                      paymentSummary = `<span class="badge bg-warning">${paidPayments}/${totalInstallments} Paid</span>`;
                    } else {
                      paymentSummary = `<span class="badge bg-secondary">${paidPayments}/${totalInstallments} Paid</span>`;
                    }
                  } else {
                    if (paidPayments === totalPayments) {
                      paymentSummary = '<span class="badge bg-success">Paid</span>';
                    } else if (overduePayments > 0) {
                      paymentSummary = '<span class="badge bg-danger">Overdue</span>';
                    } else if (pendingPayments > 0) {
                      paymentSummary = '<span class="badge bg-warning">Pending</span>';
                    } else {
                      paymentSummary = '<span class="badge bg-secondary">Unknown</span>';
                    }
                  }
                  paymentSummaryEl.innerHTML = paymentSummary;
                } else {
                  showToast('Error: ' + result.message, 'error');
                }
              } catch (error) {
                console.error('Error updating payment status:', error);
                showToast('Failed to update payment status', 'error');
              }
            });
          });

          // Add event listeners for add payment buttons
          addPaymentButtons.forEach(btn => {
            btn.addEventListener('click', async function() {
              const paymentId = this.getAttribute('data-payment-id');
              const courseTitle = this.getAttribute('data-course-title');
              const balanceRemaining = parseFloat(this.getAttribute('data-balance-remaining'));

              // Find the payment
              const payment = user.payments.find(p => p.id == paymentId);
              if (!payment) {
                showToast('Payment not found', 'error');
                return;
              }

              // Prompt for payment amount
              const paymentAmount = prompt(
                `Add Payment for ${courseTitle}\n\nTotal Course Amount: $${payment.amount}\nCurrent Balance: $${balanceRemaining}\n\nEnter payment amount:`,
                balanceRemaining.toString()
              );

              if (!paymentAmount || paymentAmount.trim() === '') {
                return; // User cancelled
              }

              const amount = parseFloat(paymentAmount);
              if (isNaN(amount) || amount <= 0) {
                showToast('Please enter a valid payment amount', 'error');
                return;
              }

              if (amount > balanceRemaining) {
                showToast(`Payment amount cannot exceed remaining balance of $${balanceRemaining}`, 'error');
                return;
              }

              if (!confirm(`Add payment of $${amount.toFixed(2)} to ${courseTitle}?\n\nRemaining balance will be $${(balanceRemaining - amount).toFixed(2)}`)) {
                return;
              }

              try {
                showToast('Adding payment...', 'info');

                const response = await fetch(`/admin/payments/${paymentId}/status`, {
                  method: 'PUT',
                  headers: {
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify({ 
                    action: 'add_payment',
                    amountPaid: amount
                  })
                });

                const result = await response.json();

                if (result.success) {
                  showToast(`Payment of $${amount.toFixed(2)} added successfully!`, 'success');
                  
                  // Update the cached user data
                  if (user.payments) {
                    const paymentToUpdate = user.payments.find(p => p.id == paymentId);
                    if (paymentToUpdate) {
                      paymentToUpdate.installment_amount = (paymentToUpdate.installment_amount || 0) + amount;
                      paymentToUpdate.total_paid = (paymentToUpdate.total_paid || 0) + amount;
                      paymentToUpdate.balance_remaining = result.data.balanceRemaining;
                      
                      if (result.data.isCompleted) {
                        paymentToUpdate.status = 'completed';
                        paymentToUpdate.installment_status = 'paid';
                      }
                      
                      // Update the data-user attribute with fresh data
                      const viewBtn = document.querySelector('.view-user-btn');
                      if (viewBtn) {
                        viewBtn.setAttribute('data-user', JSON.stringify(user));
                      }
                    }
                  }

                  // Refresh the modal to show updated data
                  // Re-populate the modal
                  personalInfoList.innerHTML = '';
                  accountInfoList.innerHTML = '';
                  coursesList.innerHTML = '';
                  paymentsList.innerHTML = '';

                  // Re-run the population logic (same as initial modal load)
                  // Personal Info
                  const personalFields = ['id', 'username', 'email', 'gender', 'role'];
                  personalFields.forEach(key => {
                    if (user[key] !== undefined && key !== 'password') {
                      personalInfoList.innerHTML += `<li class="list-group-item d-flex justify-content-between"><span>${key.charAt(0).toUpperCase() + key.slice(1)}</span><span class="fw-semibold">${user[key] ?? ''}</span></li>`;
                    }
                  });

                  // Account Info
                  const accountFields = ['createdAt', 'updatedAt'];
                  accountFields.forEach(key => {
                    if (user[key] !== undefined) {
                      let value = user[key];
                      if (key === 'createdAt' || key === 'updatedAt') {
                        value = value ? new Date(value).toLocaleString() : '';
                      }
                      accountInfoList.innerHTML += `<li class="list-group-item d-flex justify-content-between"><span>${key === 'createdAt' ? 'Joined' : 'Last Updated'}</span><span class="fw-semibold">${value}</span></li>`;
                    }
                  });

                  // Courses
                  if (user.enrollments && user.enrollments.length > 0) {
                    user.enrollments.forEach(enrollment => {
                      if (enrollment.course) {
                        coursesList.innerHTML += `<li class="list-group-item d-flex justify-content-between"><span>${enrollment.course.title}</span><span class="badge bg-success">${enrollment.course.category}</span></li>`;
                      }
                    });
                  } else {
                    coursesList.innerHTML = '<li class="list-group-item text-muted"><i class="fa-solid fa-info-circle me-2"></i>No courses yet</li>';
                  }

                  // Update payment summary
                  const totalPayments = user.payments.length;
                  const paidPayments = user.payments.filter(p => (p.installment_status || p.status) === 'paid' || (p.installment_status || p.status) === 'completed').length;
                  const pendingPayments = user.payments.filter(p => (p.installment_status || p.status) === 'pending').length;
                  const overduePayments = user.payments.filter(p => (p.installment_status || p.status) === 'overdue').length;

                  const hasInstallments = user.payments.some(p => p.total_installments > 1);
                  const totalInstallments = hasInstallments ? Math.max(...user.payments.map(p => p.total_installments || 1)) : 1;

                  let paymentSummary = '';
                  if (hasInstallments) {
                    if (paidPayments === totalInstallments) {
                      paymentSummary = '<span class="badge bg-success">All Paid</span>';
                    } else if (overduePayments > 0) {
                      paymentSummary = `<span class="badge bg-danger">${paidPayments}/${totalInstallments} Paid (${overduePayments} Overdue)</span>`;
                    } else if (pendingPayments > 0) {
                      paymentSummary = `<span class="badge bg-warning">${paidPayments}/${totalInstallments} Paid</span>`;
                    } else {
                      paymentSummary = `<span class="badge bg-secondary">${paidPayments}/${totalInstallments} Paid</span>`;
                    }
                  } else {
                    if (paidPayments === totalPayments && result.data.isCompleted) {
                      paymentSummary = '<span class="badge bg-success">Paid</span>';
                    } else if (overduePayments > 0) {
                      paymentSummary = '<span class="badge bg-danger">Overdue</span>';
                    } else if (pendingPayments > 0) {
                      paymentSummary = '<span class="badge bg-warning">Pending</span>';
                    } else {
                      paymentSummary = '<span class="badge bg-secondary">Unknown</span>';
                    }
                  }
                  paymentSummaryEl.innerHTML = paymentSummary;

                  // Re-populate payments list
                  if (user.payments && user.payments.length > 0) {
                    const paymentHtml = user.payments.map(payment => {
                      const courseTitle = payment.course ? payment.course.title : 'Unknown Course';
                      const installmentInfo = payment.total_installments > 1 ?
                        ` (Installment ${payment.installment_number}/${payment.total_installments})` : '';

                      let statusBadge = '';
                      switch (payment.installment_status || payment.status) {
                        case 'paid':
                        case 'completed':
                          statusBadge = '<span class="badge bg-success">Paid</span>';
                          break;
                        case 'pending':
                          statusBadge = '<span class="badge bg-warning">Pending</span>';
                          break;
                        case 'overdue':
                          statusBadge = '<span class="badge bg-danger">Overdue</span>';
                          break;
                        case 'failed':
                          statusBadge = '<span class="badge bg-danger">Failed</span>';
                          break;
                        case 'cancelled':
                          statusBadge = '<span class="badge bg-secondary">Cancelled</span>';
                          break;
                        default:
                          statusBadge = '<span class="badge bg-secondary">Unknown</span>';
                      }

                      const paidDate = payment.paid_date ? new Date(payment.paid_date).toLocaleDateString() : 'N/A';
                      const balanceInfo = payment.balance_remaining > 0 ?
                        `<div class="text-muted small">Balance Remaining: $${payment.balance_remaining}</div>` : '';

                      // Show add payment button if there's remaining balance
                      const addPaymentButton = payment.balance_remaining > 0 ?
                        `<button class="btn btn-success btn-sm add-payment-btn ms-2" 
                                 data-payment-id="${payment.id}"
                                 data-course-title="${courseTitle}"
                                 data-balance-remaining="${payment.balance_remaining}">
                          <i class="fa-solid fa-plus"></i> Add Payment
                        </button>` : '';

                      return `
                        <div class="mb-3 p-3 border rounded">
                          <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="flex-grow-1">
                              <div class="fw-semibold">${courseTitle}${installmentInfo}</div>
                              <div class="text-muted small">Total Amount: $${payment.amount}</div>
                              <div class="text-muted small">Total Paid: $${payment.total_paid || 0}</div>
                              <div class="text-muted small">Paid Date: ${paidDate}</div>
                              ${balanceInfo}
                            </div>
                            <div class="d-flex flex-column gap-2" style="min-width: 200px;">
                              <div class="input-group input-group-sm">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control form-control-sm amount-paid-input" 
                                       data-payment-id="${payment.id}" 
                                       placeholder="Amount Paid" 
                                       step="0.01" 
                                       min="0"
                                       value="${payment.installment_status === 'paid' || payment.status === 'completed' ? (payment.installment_amount || payment.amount) : ''}">
                              </div>
                              <div class="d-flex gap-1">
                                <select class="form-select form-select-sm payment-status-select" 
                                        data-payment-id="${payment.id}" 
                                        style="flex: 1;">
                                  <option value="pending" ${payment.installment_status === 'pending' || payment.status === 'pending' ? 'selected' : ''}>Pending</option>
                                  <option value="paid" ${payment.installment_status === 'paid' || payment.status === 'completed' ? 'selected' : ''}>Paid</option>
                                  <option value="overdue" ${payment.installment_status === 'overdue' ? 'selected' : ''}>Overdue</option>
                                  <option value="failed" ${payment.installment_status === 'failed' || payment.status === 'failed' ? 'selected' : ''}>Failed</option>
                                  <option value="cancelled" ${payment.installment_status === 'cancelled' || payment.status === 'cancelled' ? 'selected' : ''}>Cancelled</option>
                                </select>
                                <button class="btn btn-outline-primary btn-sm update-payment-btn" 
                                        data-payment-id="${payment.id}"
                                        data-current-status="${payment.installment_status || payment.status}">
                                  <i class="fa-solid fa-save"></i>
                                </button>
                                ${addPaymentButton}
                              </div>
                            </div>
                          </div>
                        </div>
                      `;
                    }).join('');
                    paymentsList.innerHTML = paymentHtml;

                    // Re-add listeners
                    setTimeout(() => {
                      addPaymentUpdateListeners(user);
                    }, 100);
                  } else {
                    paymentsList.innerHTML = '<div class="text-muted small">No payments found</div>';
                  }

                } else {
                  showToast('Error: ' + result.message, 'error');
                }
              } catch (error) {
                console.error('Error adding payment:', error);
                showToast('Failed to add payment', 'error');
              }
            });
          });
        }

        // Delete user button logic
        document.getElementById('deleteUserBtn').onclick = async function() {
          if (!currentUser) return;

          if (confirm('Are you sure you want to delete this user? This action cannot be undone and will delete all related data (enrollments, payments, activities).')) {
            try {
              showToast('Deleting user...', 'info');

              const response = await fetch(`/admin/users/${currentUser.id}`, {
                method: 'DELETE',
                headers: {
                  'Content-Type': 'application/json',
                }
              });

              const result = await response.json();

              if (result.success) {
                showToast(result.message, 'success');

                // Close the modal
                const modal = bootstrap.Modal.getInstance(userDetailsModal);
                modal.hide();

                // Remove the user row from the table
                const userRow = document.querySelector(`[data-user*='"id":${currentUser.id}']`);
                if (userRow) {
                  userRow.closest('tr').remove();
                }

                // Also remove from awaiting users table if present
                const awaitingRow = document.querySelector(`.awaiting-user-row [data-user*='"id":${currentUser.id}']`);
                if (awaitingRow) {
                  awaitingRow.closest('tr').remove();
                }

                // Refresh the page after a short delay to update statistics
                setTimeout(() => {
                  window.location.reload();
                }, 2000);

              } else {
                showToast('Error: ' + result.message, 'error');
              }
            } catch (error) {
              console.error('Error deleting user:', error);
              showToast('Failed to delete user. Please try again.', 'error');
            }
          }
        };

        // Suspend user button logic
        document.getElementById('suspendUserBtn').onclick = async function() {
          if (!currentUser) return;
          if (confirm('Suspend this user account?')) {
            // TODO: Implement AJAX call to suspend user
            alert('Suspend user: ' + currentUser.id);
          }
        };
      });
    </script>

    <!-- New Meeting Modal (admin dashboard) -->
    <div class="modal fade modal-admin-meeting" id="adminMeetingModal" tabindex="-1" aria-labelledby="adminMeetingModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="adminMeetingModalLabel">Schedule Meeting</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form id="adminMeetingForm" class="small">
            <div class="modal-body">
              <div class="mb-3">
                <label for="adminMeetingTitle" class="form-label small fw-semibold">Title</label>
                <input type="text" class="form-control form-control-sm" id="adminMeetingTitle" name="title" placeholder="e.g. Sprint planning with team" required />
              </div>
              <div class="row g-2">
                <div class="col-6">
                  <label for="adminMeetingDate" class="form-label small fw-semibold">Date</label>
                  <input type="date" class="form-control form-control-sm" id="adminMeetingDate" name="date" required />
                </div>
                <div class="col-6">
                  <label for="adminMeetingTime" class="form-label small fw-semibold">Time</label>
                  <input type="time" class="form-control form-control-sm" id="adminMeetingTime" name="time" />
                  <div class="form-text small">Leave empty for all-day meeting.</div>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-success btn-sm">Save Meeting</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
      <div id="emailToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
          <div class="toast-body d-flex align-items-center">
            <i id="toastIcon" class="fa-solid me-2"></i>
            <span id="toastMessage"></span>
          </div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
      </div>
    </div>

    <!-- Toast Styles -->
    <style>
      .toast-container {
        z-index: 9999;
      }
      .toast-success {
        background-color: #198754 !important;
        border-color: #198754 !important;
      }
      .toast-error {
        background-color: #dc3545 !important;
        border-color: #dc3545 !important;
      }
      .toast-info {
        background-color: #0dcaf0 !important;
        border-color: #0dcaf0 !important;
        color: #000 !important;
      }
      .toast-info .btn-close-white {
        filter: invert(1);
      }
    </style>

   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="/js/main.js" defer></script>
  </body>
  
</html>
